# Tokens de acesso ao console (gere com: openssl rand -hex 32)
NETCONSOLE_ADMIN_TOKEN=
# Opcional: token somente-leitura (NOC / helpdesk)
NETCONSOLE_VIEWER_TOKEN=
# Opcional: chave Fernet p/ cifrar credenciais dos vendors (se vazio, gera em /data/secret.key)
NETCONSOLE_SECRET_KEY=
# Intervalo de coleta em segundos
NETCONSOLE_SYNC_INTERVAL=300
